@@ -0,0 +1,52 @@
+package middleware
+
+import (
+	"encoding/json"
+	"net/http"
+	"net/http/httptest"
+	"strings"
+	"testing"
+
+	"github.com/gin-gonic/gin"
+	"github.com/ollama/ollama/openai"
+)
+
+// Verify the client-visible error and that rejected input never reaches inference.
+func TestCapstoneChatValidation(t *testing.T) {
+	gin.SetMode(gin.TestMode)
+	for _, tc := range []struct{ name, body, message string }{
+		{"malformed JSON", `{"model":`, "unexpected EOF"},
+		{"missing messages", `{"model":"test-model"}`, "[] is too short - 'messages'"},
+		{"empty messages", `{"model":"test-model","messages":[]}`, "[] is too short - 'messages'"},
+		{"unsupported content", `{"model":"test-model","messages":[{"role":"user","content":2}]}`, "invalid message content type: float64"},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			called := false
+			r := gin.New()
+			r.POST("/v1/chat/completions", ChatMiddleware(), func(c *gin.Context) {
+				called = true
+				c.Status(http.StatusOK)
+			})
+			req := httptest.NewRequest(http.MethodPost, "/v1/chat/completions", strings.NewReader(tc.body))
+			req.Header.Set("Content-Type", "application/json")
+			resp := httptest.NewRecorder()
+			r.ServeHTTP(resp, req)
+			if resp.Code != http.StatusBadRequest {
+				t.Fatalf("status = %d, want 400; body=%s", resp.Code, resp.Body.String())
+			}
+			if called {
+				t.Fatal("invalid request reached downstream handler")
+			}
+			var got openai.ErrorResponse
+			if err := json.Unmarshal(resp.Body.Bytes(), &got); err != nil {
+				t.Fatal(err)
+			}
+			if got.Error.Type != "invalid_request_error" {
+				t.Fatalf("type = %q", got.Error.Type)
+			}
+			if got.Error.Message != tc.message {
+				t.Fatalf("message = %q, want %q", got.Error.Message, tc.message)
+			}
+		})
+	}
+}
